{
  "schemaVersion": 1,
  "id": "grandstrategy",
  "version": "${version}",
  "name": "Grand Strategy",
  "description": "Nations grow, trade, research and wage war across a vanilla world. Vanilla villages stay independent settlements.",
  "authors": [],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "com.grandstrategy.GrandStrategy"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "com.grandstrategy.client.GrandStrategyClient"
      }
    ]
  },
  "mixins": [
    "grandstrategy.mixins.json",
    {
      "config": "grandstrategy.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25"
  },
  "recommends": {
    "crowdperf": "*"
  }
}
